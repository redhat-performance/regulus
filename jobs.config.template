#
# per job/run config
#
# IMPORTANT: This file is parsed by the Makefile's 'include ./jobs.config' directive,
# NOT executed as a bash script. It follows GNU Make syntax, not shell syntax.
# - Do NOT use quotes around values (Make will treat them as literal characters)
# - To override with shell syntax (with quotes), export from the shell before make:
#   export NUM_THREADS="1,2,3" && make init
#

# Project. Default is crucible-rickshaw
export OCP_PROJECT=crucible-myproject

# Jobs, a list. This list conforms to GNU make i.e tab in each line, and no quote ""
#	./1_GROUP/NO-PAO/4IP/INTER-NODE/TCP/2-POD 
export JOBS= \
	./SANDBOX

# Debug. DRY run. Default is false. Set to true to DRY
export DRY_RUN=false

# Artifact directory prefix. Default is null.  For example: run-ALL-18feb-UUDID....
export TAG=ALL-18feb 

# Number of samples per test. Default is 3
export NUM_SAMPLES=1

# The duration in seconds to run each test iteration. Default is 120
export DURATION=120

# Thread counts to test. Format: comma-separated values, no quotes (e.g., 1 or 1,2,4,8)
export NUM_THREADS=1,2,4,8
